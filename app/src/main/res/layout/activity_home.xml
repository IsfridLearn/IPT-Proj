<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F6F4">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/headerBg"
            android:layout_width="0dp"
            android:layout_height="260dp"
            android:background="#1F3A63"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_marginTop="-60dp"
            android:layout_marginStart="-40dp"
            app:cardCornerRadius="70dp"
            app:cardBackgroundColor="#26497A"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.cardview.widget.CardView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-30dp"
            app:cardCornerRadius="45dp"
            app:cardBackgroundColor="#26497A"
            app:cardElevation="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.cardview.widget.CardView
            android:id="@+id/logoCard"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginTop="48dp"
            app:cardCornerRadius="48dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"
                android:contentDescription="Logo" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/orgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Green Horizon"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            app:layout_constraintTop_toBottomOf="@id/logoCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/orgTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Growing together, rooted in community"
            android:textColor="#AFC0D8"
            android:textSize="12sp"
            app:layout_constraintTop_toBottomOf="@id/orgName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            app:layout_constraintTop_toBottomOf="@id/orgTagline"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.cardview.widget.CardView android:layout_width="7dp" android:layout_height="7dp"
                app:cardCornerRadius="4dp" app:cardBackgroundColor="#6D8CB8" android:layout_marginEnd="6dp" />
            <androidx.cardview.widget.CardView android:layout_width="7dp" android:layout_height="7dp"
                app:cardCornerRadius="4dp" app:cardBackgroundColor="#D32E3F" android:layout_marginEnd="6dp" />
            <androidx.cardview.widget.CardView android:layout_width="7dp" android:layout_height="7dp"
                app:cardCornerRadius="4dp" app:cardBackgroundColor="#F4B223" android:layout_marginEnd="6dp" />
            <androidx.cardview.widget.CardView android:layout_width="7dp" android:layout_height="7dp"
                app:cardCornerRadius="4dp" app:cardBackgroundColor="#6BA43A" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:id="@+id/formCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="-46dp"
            android:layout_marginHorizontal="20dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/headerBg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="26dp">

                <TextView
                    android:id="@+id/welcomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome Back!"
                    android:textColor="#1F3A63"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/welcomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="You are signed in to Green Horizon"
                    android:textColor="#9296A0"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/welcomeTitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/emailLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:text="SIGNED IN USER"
                    android:textColor="#B4B8C2"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    app:layout_constraintTop_toBottomOf="@id/welcomeSubtitle"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/emailField"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="#F4F5F3"
                    app:layout_constraintTop_toBottomOf="@id/emailLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <View
                    android:layout_width="3dp"
                    android:layout_height="0dp"
                    android:background="#6BA43A"
                    app:layout_constraintTop_toTopOf="@id/emailField"
                    app:layout_constraintBottom_toBottomOf="@id/emailField"
                    app:layout_constraintStart_toStartOf="@id/emailField" />

                <TextView
                    android:id="@+id/userEmailTextView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:text="user@email.com"
                    android:textColor="#1F3A63"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/emailField"
                    app:layout_constraintBottom_toBottomOf="@id/emailField"
                    app:layout_constraintStart_toStartOf="@id/emailField"
                    app:layout_constraintEnd_toEndOf="@id/emailField" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/logoutButtonCard"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    app:cardCornerRadius="14dp"
                    app:cardBackgroundColor="#D32E3F"
                    app:cardElevation="6dp"
                    app:layout_constraintTop_toBottomOf="@id/emailField"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/logoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="LOG OUT"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:clickable="true"
                        android:focusable="true" />
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
